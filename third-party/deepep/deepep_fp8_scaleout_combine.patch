diff --git a/deep_ep/include/deep_ep/impls/combine_utils.cuh b/deep_ep/include/deep_ep/impls/combine_utils.cuh
index 6139bf0..db3b9e2 100644
--- a/deep_ep/include/deep_ep/impls/combine_utils.cuh
