 NCCL_PARAM(GinErrorQuerySec, "GIN_ERROR_QUERY_SEC", 10);
+// injection rate of every GIN QP, as an ibv_rate value (0: the port rate); read when each GIN context is
+// created, not cached as NCCL_PARAM, so one process can give its device communicators different rates
+static int64_t ncclParamGinStaticRate() {
+  const char* value = getenv("NCCL_GIN_STATIC_RATE");
+  return value ? atoll(value) : 0;
+}
 NCCL_PARAM(GinIbOooAll, "GIN_IB_OOO_OPT", 0);
